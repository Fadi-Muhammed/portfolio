# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable here is validated at boot by src/lib/env.ts.

# Public — inlined into the client bundle by Next. Never put a secret here.
# The site's own origin, no trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Set to "true" to expose the /design token playground. It is noindex either way.
# Leave blank or "false" everywhere except when reviewing the design system.
NEXT_PUBLIC_ENABLE_DESIGN_ROUTE=

# --- Supabase -----------------------------------------------------------------
# Dashboard: Settings > Data API (URL) and Settings > API Keys (the two keys).

# Public. The project's base URL, no path and no trailing slash.
# https://<ref>.supabase.co  — NOT the /rest/v1 endpoint the dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=

# Public. The anon (or publishable) key. Safe in the browser: it can only read
# published rows, because that is all the RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. The service_role (or secret) key. Bypasses every RLS policy, so it is
# server-only and must never take a NEXT_PUBLIC_ prefix. Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > General > Reference ID. Not sensitive.
SUPABASE_PROJECT_REF=

# --- Supabase CLI, local tooling only. Not needed in Vercel. -------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# The database password from project creation. Needed by `npm run db:push`.
SUPABASE_DB_PASSWORD=

# SECRET. Shared secret for POST /api/revalidate, called by the Supabase database
# webhook so edits in Studio appear immediately instead of after ~300s.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# ---- Contact form (Part 13) -------------------------------------------------
# Cloudflare Turnstile. Create a Managed widget at dash.cloudflare.com -> Turnstile
# with two hostnames: your domain and localhost. Without localhost the widget will
# not render in development. The site key is public and ships in the page; the
# secret verifies the token server-side and must not gain a NEXT_PUBLIC_ prefix.
#
# CI and Vercel previews use Cloudflare's published always-pass test keys, because a
# preview runs on *.vercel.app and that cannot be added to the widget's hostnames:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend, for the notification email. Use a Sending access key, not Full access.
# CONTACT_FROM_EMAIL is Resend's shared sender until the domain is verified; that
# sender can only deliver to the address which owns the Resend account, which is
# what CONTACT_TO_EMAIL has to be.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=

# ---- Maintenance mode (Part 14) ---------------------------------------------
# Both optional, and both unset means the site is up — which is the normal state,
# so neither is validated in env.ts and a missing one is never an error.
#
# MAINTENANCE_MODE=true and every request is rewritten to /maintenance with a 503.
# Only the exact string "true" counts: a flag that takes the site down should not be
# switchable by "1" or "yes" landing in the wrong variable.
#
# MAINTENANCE_BYPASS_KEY is how you get in while it is on. Visit any URL once with
# ?key=<the key>; it is traded for an httpOnly cookie and removed from the URL, so
# the key does not stay in your history or in a screenshot. Generate a long random
# one — for example: node -e "console.log(crypto.randomUUID())" — and note that with
# no key set, nobody can bypass, including you.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=
