# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every variable here is validated at boot by src/lib/env.ts.

# Public — inlined into the client bundle by Next. Never put a secret here.
# The site's own origin, no trailing slash. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Set to "true" to expose the /design token playground. It is noindex either way.
# Leave blank or "false" everywhere except when reviewing the design system.
NEXT_PUBLIC_ENABLE_DESIGN_ROUTE=

# --- Supabase -----------------------------------------------------------------
# Dashboard: Settings > Data API (URL) and Settings > API Keys (the two keys).

# Public. The project's base URL, no path and no trailing slash.
# https://<ref>.supabase.co  — NOT the /rest/v1 endpoint the dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=

# Public. The anon (or publishable) key. Safe in the browser: it can only read
# published rows, because that is all the RLS policies allow.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. The service_role (or secret) key. Bypasses every RLS policy, so it is
# server-only and must never take a NEXT_PUBLIC_ prefix. Set it in Vercel too.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > General > Reference ID. Not sensitive.
SUPABASE_PROJECT_REF=

# --- Supabase CLI, local tooling only. Not needed in Vercel. -------------------
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# The database password from project creation. Needed by `npm run db:push`.
SUPABASE_DB_PASSWORD=
